# Telegram bot token (used to validate Telegram WebApp initData via HMAC-SHA256)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Shared secret required in the x-admin-key header for /api/admin/* routes
ADMIN_API_KEY=change-me-to-a-long-random-string

# Optional: shared secret Adsgram (or your ad network's server-to-server callback)
# can use to sign the completion token you verify in utils/adsgram.js
ADSGRAM_VERIFY_SECRET=change-me-too

PORT=4000

# Turso (libSQL) database — from `turso db show <name> --url` and
# `turso db tokens create <name>`. See the deployment README for the
# full walkthrough.
TURSO_DATABASE_URL=libsql://your-db-name-yourusername.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZFDSA...
