# Telegram bot token (used to validate Telegram WebApp initData via
# HMAC-SHA256, and to call the Telegram Bot API from routes/bot.js)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Shared secret required in the x-admin-key header for /api/admin/* routes
ADMIN_API_KEY=change-me-to-a-long-random-string

PORT=4000

# Turso (libSQL) database — create at app.turso.tech (no CLI needed), copy
# the Database URL and an auth token from its dashboard.
TURSO_DATABASE_URL=libsql://your-db-name-yourusername.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZFDSA...

# Random string YOU make up — put it in your webhook URL when you call
# Telegram's setWebhook (see DEPLOYMENT.md). Stops random requests from
# pretending to be Telegram.
BOT_WEBHOOK_SECRET=make-up-a-long-random-string

# Where your frontend actually lives (e.g. your Vercel URL). Used for the
# "Play" button in the bot's welcome message.
MINI_APP_URL=https://your-app.vercel.app

# Your backend's own public URL (e.g. https://aihackslab.tech) — used to
# build the welcome photo's URL (BACKEND_PUBLIC_URL/assets/welcome.png).
# Without this set, the welcome message falls back to plain text with no
# image, rather than failing outright.
BACKEND_PUBLIC_URL=https://your-backend-domain.com

# Optional — links shown as buttons under the welcome photo. Any of
# these left unset simply omits that button rather than showing a dead
# link. Point them at your actual payment info, official channel, and
# support contact/channel once you have them.
ADLX_PAY_URL=
ADLX_OFFICIAL_URL=
ADLX_SUPPORT_URL=

# Same URL, no trailing slash — used to restrict CORS so only your actual
# frontend can call this API.
FRONTEND_URL=https://your-app.vercel.app

# Another random string YOU make up — put it in the Postback URL you
# configure for each ad zone in the Monetag dashboard (see DEPLOYMENT.md).
# Same purpose as BOT_WEBHOOK_SECRET: stops anyone from hitting the
# postback endpoint directly and faking a reward confirmation.
MONETAG_POSTBACK_SECRET=make-up-another-long-random-string

# Same idea, for Adsgram's Reward Url instead — see the note in the admin
# panel's Settings card for the exact URL format to paste into
# https://partner.adsgram.ai/ once you've set an Adsgram Block ID there.
ADSGRAM_VERIFY_SECRET=make-up-yet-another-long-random-string

# Optional — your public Telegram channel's @username (proof-of-payout
# posts for Adsgram/Monetag review, and general trust). Leave unset to
# turn this off entirely. Add this line yourself once you've created the
# channel — nothing else needs to change.
WITHDRAWAL_ANNOUNCE_CHANNEL=@YourPublicChannel
